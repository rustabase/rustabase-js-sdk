{
    "version": "1.0.1",
    "name": "rustabase-js-sdk",
    "description": "Official JavaScript and TypeScript SDK for RustaBase",
    "author": "RustaBase contributors",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/rustabase/rustabase-js-sdk.git"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/rustabase.es.mjs",
            "require": "./dist/rustabase.cjs.js"
        },
        "./umd": "./dist/rustabase.umd.js"
    },
    "main": "./dist/rustabase.cjs.js",
    "module": "./dist/rustabase.es.mjs",
    "react-native": "./dist/rustabase.es.mjs",
    "types": "./dist/index.d.ts",
    "sideEffects": false,
    "files": [
        "dist",
        "LICENSE.md",
        "README.md"
    ],
    "keywords": [
        "rustabase",
        "rustabase-js",
        "postgresql",
        "backend-as-a-service",
        "js-sdk",
        "database-client"
    ],
    "prettier": {
        "tabWidth": 4,
        "printWidth": 90,
        "bracketSameLine": true
    },
    "scripts": {
        "format": "npx prettier ./src ./tests --write",
        "build": "rm -rf dist && rollup -c",
        "dev": "rollup -c -w",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run build"
    },
    "devDependencies": {
        "@rollup/plugin-terser": "^0.4.3",
        "@rollup/plugin-typescript": "^12.3.0",
        "prettier": "3.2.4",
        "rollup": "^4.0.0",
        "tslib": "^2.8.1",
        "typescript": "^5.1.6",
        "vitest": "^2.0.0"
    },
    "homepage": "https://github.com/rustabase/rustabase-js-sdk",
    "bugs": {
        "url": "https://github.com/rustabase/rustabase-js-sdk/issues"
    }
}
